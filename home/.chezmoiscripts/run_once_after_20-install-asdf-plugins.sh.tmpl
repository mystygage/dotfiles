#!/usr/bin/env bash
{{ template "script_eval_brew" . }}

$(brew --prefix asdf)/bin/asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git
$(brew --prefix asdf)/bin/asdf plugin add java https://github.com/halcyon/asdf-java.git
$(brew --prefix asdf)/bin/asdf plugin add python https://github.com/asdf-community/asdf-python.git
$(brew --prefix asdf)/bin/asdf plugin add golang https://github.com/asdf-community/asdf-golang.git
$(brew --prefix asdf)/bin/asdf plugin add bun https://github.com/cometkim/asdf-bun.git

$(brew --prefix asdf)/bin/asdf install
