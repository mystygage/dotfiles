#!/usr/bin/env bash

set -euo pipefail

{{ template "script_darwin_only" . }}

# run_once fires again whenever this script changes, so every step checks first.

# XDG Cache folder
# ~/Library/Caches directory is excluded from Time Machine by default.
XDG_CACHE_FOLDER="${HOME}/Library/Caches/XDG-cache"
HOME_CACHE_FOLDER="${HOME}/.cache"
if [ ! -L "${HOME_CACHE_FOLDER}" ] ; then
  if [ -e "${XDG_CACHE_FOLDER}" ] ; then
    # Target already exists: move contents instead of nesting ~/.cache inside it
    mkdir -p "${HOME_CACHE_FOLDER}"
    rsync -a "${HOME_CACHE_FOLDER}/" "${XDG_CACHE_FOLDER}/"
    rm -rf "${HOME_CACHE_FOLDER}"
  else
    mkdir -p "${HOME_CACHE_FOLDER}"
    mv "${HOME_CACHE_FOLDER}" "${XDG_CACHE_FOLDER}"
  fi
  ln -s "${XDG_CACHE_FOLDER}" "${HOME_CACHE_FOLDER}"
fi

# Check if the Xcode license is agreed to and agree if not.
if /usr/bin/xcrun clang 2>&1 | grep -q license; then
  echo "Asking for Xcode license confirmation:"
  sudo xcodebuild -license
fi

# Only list updates: installing them can restart the Mac or start a major upgrade,
# and a failure here would block the deployment.
echo "Checking for software updates:"
softwareupdate -l 2>&1 || true
echo "Install them with: sudo softwareupdate --install --all"
