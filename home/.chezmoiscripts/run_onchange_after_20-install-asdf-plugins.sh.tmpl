{{- /* Linux is opt-in: renders empty until asdf exists, so it runs once it does */ -}}
{{- if or (eq .chezmoi.os "darwin") (lookPath "asdf") -}}
#!/usr/bin/env bash

set -euo pipefail

# Re-runs when the pinned versions change, so a new version gets installed
# .tool-versions: {{ include "dot_tool-versions" | sha256sum }}

{{ template "script_eval_brew" . }}

# Same locations as zshenv: a fresh apply runs before any shell has read it
export ASDF_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/asdf/asdfrc"
export ASDF_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/asdf"

# Refs pinned in .chezmoidata.toml. `add` ignores a ref, `update` checks it out.
{{- range $name, $plugin := .pins.asdf }}
asdf plugin add {{ $name }} https://github.com/{{ $plugin.repo }}.git
asdf plugin update {{ $name }} {{ $plugin.ref }}
{{- end }}

asdf install
{{ end -}}
