{{ if eq .chezmoi.os "darwin" }}
[credential]
    helper = osxkeychain
{{ end }}
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
    # Sign with whichever YubiKey is plugged in, if allowed_signers lists it
    # (keys in .chezmoidata.toml). Absolute path: GUI apps lack ~/.local/bin.
    defaultKeyCommand = {{ .chezmoi.homeDir }}/.local/bin/git-signing-key
[init]
    defaultBranch = main
[advice]
    addIgnoredFile = false
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[merge]
    conflictstyle = diff3
[commit]
    verbose = true
{{- if eq .chezmoi.os "darwin" }}
    gpgsign = true
[tag]
    gpgsign = true
{{- end }}
[pull]
    rebase = true
[fetch]
    prune = true
[transfer]
    # Check every received object, this also catches malicious .gitmodules.
    # An old repo with broken history: git -c transfer.fsckObjects=false clone ...
    fsckObjects = true
[push]
    default = simple
[rerere]
    enabled = true
[alias]
    fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"

    # Nice git log (Source: https://stackoverflow.com/a/9074343/1776566)
    lg = lg1-specific
    lg1 = lg1-specific --all
    lg2 = lg2-specific --all
    lg3 = lg3-specific --all

    lg1-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
    lg2-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
    lg3-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset) %C(bold cyan)(committed: %cD)%C(reset) %C(auto)%d%C(reset)%n''          %C(white)%s%C(reset)%n''          %C(dim white)- %an <%ae> %C(reset) %C(dim white)(committer: %cn <%ce>)%C(reset)'
