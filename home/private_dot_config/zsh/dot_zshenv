#
# Defines environment variables.
#

# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

# Use XDG Base Directory configuration, see https://wiki.archlinux.org/title/XDG_Base_Directory
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:=$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:=$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:=$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:=$HOME/.local/state}"

export ASDF_CONFIG_FILE="${XDG_CONFIG_HOME}/asdf/asdfrc"
export ASDF_DATA_DIR="${XDG_DATA_HOME}/asdf"

# One order for login and non-login shells: shims first so .tool-versions wins,
# user dirs last so they can't shadow system tools.
typeset -gU path
path=("${ASDF_DATA_DIR}/shims" ${path:#${HOME}/(.local/bin|.docker/bin(|/))} "${HOME}/.local/bin" "${HOME}/.docker/bin")

# use neovim as default editor
export EDITOR='nvim'
export VISUAL='nvim'

# Ubuntu's /etc/zsh/zshrc runs a plain compinit before prezto's. That is redundant,
# and with an insecure directory in fpath it stops every new shell with a question.
skip_global_compinit=1
