# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#
# Executes commands at the start of an interactive session.
#

# Cache Homebrew prefix to avoid repeated `brew --prefix` calls (~50ms each)
if [[ -z "$HOMEBREW_PREFIX" ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    export HOMEBREW_PREFIX=/opt/homebrew
  elif [[ -x /usr/local/bin/brew ]]; then
    export HOMEBREW_PREFIX=/usr/local
  fi
fi

# Homebrew's zsh completions must be inserted in `FPATH` before zprezto init
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  FPATH="${HOMEBREW_PREFIX}/share/zsh/site-functions:${FPATH}"
fi

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...

# In login shells path_helper and prezto's zprofile moved brew and system paths
# in front of the shims from zshenv.
path=("${ASDF_DATA_DIR}/shims" $path)

# Optimize the history
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE

# ignore accidental yubikey input
HISTORY_IGNORE="cccccc*"

# ensure a big history
HISTSIZE=200000
SAVEHIST=100000

# fzf search for ctrl-r
[ -f ~/.config/fzf/fzf.zsh ] && source ~/.config/fzf/fzf.zsh

# asdf version manager
# Runtime env for Java and Go. The plugins' own hooks spawn asdf on every prompt,
# this only runs at startup and on cd.
_asdf_runtime_env() {
  local dir
  if dir="$(asdf where java 2>/dev/null)" && [[ -n "$dir" ]]; then
    export JAVA_HOME="$dir" JDK_HOME="$dir"
  fi
  if dir="$(asdf where golang 2>/dev/null)" && [[ -n "$dir" ]]; then
    export GOROOT="$dir/go" GOPATH="$dir/packages" GOBIN="$dir/bin"
  fi
}
if (( $+commands[asdf] )); then
  autoload -U add-zsh-hook
  add-zsh-hook chpwd _asdf_runtime_env
  _asdf_runtime_env
fi

# Cache shell-init evals to avoid spawning subprocesses on every startup.
_zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$_zsh_cache_dir" ]] || mkdir -p "$_zsh_cache_dir"

_cached_eval() {
  # $1 = cache filename, $2... = command to produce the eval output
  local cache="${_zsh_cache_dir}/$1"; shift
  if [[ ! -s "$cache" ]]; then
    "$@" >| "$cache" 2>/dev/null
  fi
  source "$cache"
}

# Jump, `cd` on steroids
# Usage: `j dotfiles` instead of `cd ~/Projects/private/dotfiles`
(( $+commands[jump] )) && _cached_eval jump.zsh jump shell

# 1Password CLI
if command -v op &>/dev/null; then
  _cached_eval op-completion.zsh op completion zsh
  compdef _op op
fi

# use yubikey agent
[[ -S "${HOMEBREW_PREFIX}/var/run/yubikey-agent.sock" ]] && export SSH_AUTH_SOCK="${HOMEBREW_PREFIX}/var/run/yubikey-agent.sock"

# use nvim instead of vim/vi
if (( $+commands[nvim] )); then
  alias vim="nvim"
  alias vi="nvim"
  alias oldvim="\vim"
else
  # zshenv defaults to nvim, fall back on hosts without it
  export EDITOR='vi' VISUAL='vi'
fi

# eza instead of ls (https://github.com/eza-community/eza)
if (( $+commands[eza] )); then
  alias l='eza'
  alias la='eza -a'
  alias ll='eza -lah'
  alias ls='eza --color=auto'
fi

# Maven alias to support XDG Base Directory specification
# https://issues.apache.org/jira/browse/MNG-6603
[[ -f "${XDG_CONFIG_HOME}/maven/settings.xml" ]] && alias mvn='mvn -gs "${XDG_CONFIG_HOME}"/maven/settings.xml'

# Git Alias
# Delete local branches whose upstream is gone
gcleanremote() {
  git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
    | awk '$2 == "[gone]" { print $1 }' \
    | xargs -r git branch -d
}

# Delete local branches merged into main, keep the long-lived ones
gcleanlocal() {
  git for-each-ref --merged main --format='%(refname:short)' refs/heads \
    | grep -vxE 'main|master|develop' \
    | xargs -r git branch -d
}

# Kubernetes
alias k='kubectl'
alias kc='kubectl config use-context'
alias kn='kubectl config set-context --current --namespace'

# Pick context or namespace with fzf. Cancelling changes nothing.
kfc() {
  local context
  context="$(kubectl config get-contexts -o name | fzf --height=6 --prompt="Kubernetes Context> ")"
  [[ -n "$context" ]] || return 0
  kubectl config use-context "$context"
}

kfn() {
  local namespace
  namespace="$(kubectl get ns -o name | fzf -d/ --with-nth=2 | cut -d/ -f2)"
  [[ -n "$namespace" ]] || return 0
  kubectl config set-context --current --namespace "$namespace"
}

if (( $+commands[kubectl] )); then
  [[ -f "${HOME}/.local/bin/load-k8s-configs.sh" ]] && source "${HOME}/.local/bin/load-k8s-configs.sh"
  _cached_eval kubectl-completion.zsh kubectl completion zsh
fi

# To customize prompt, run `p10k configure` or edit "${ZDOTDIR:-$HOME}/.p10k.zsh".
[[ ! -f "${ZDOTDIR:-$HOME}/.p10k.zsh" ]] || source "${ZDOTDIR:-$HOME}/.p10k.zsh"
